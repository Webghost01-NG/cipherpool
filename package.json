{
  "name": "veylott",
  "version": "1.0.0",
  "description": "A rigorous security research, formal analysis, and adversarial verification project focused on confidential prize savings protocols built on Zama's Fully Homomorphic Encryption Virtual Machine (fhEVM).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "forge test && npm run test:backend && npm run test:client && npm run test:frontend",
    "build:backend": "tsc",
    "test:backend": "tsx --test backend/test/*.test.ts",
    "test:client": "tsx --test client/test/*.test.ts",
    "build:frontend": "vite build && npm run verify:frontend-bundle",
    "verify:frontend-bundle": "node scripts/verify-frontend-bundle.mjs",
    "verify:yield-route": "node scripts/verify-sepolia-yield-route.mjs",
    "test:frontend": "tsx --test frontend/test/*.test.ts",
    "fund:sponsor-reserve": "tsx scripts/fund-sponsor-reserve.ts",
    "lifecycle:sepolia": "tsx scripts/live-prize-lifecycle.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Webghost01-NG/veylott.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Webghost01-NG/veylott/issues"
  },
  "homepage": "https://github.com/Webghost01-NG/veylott#readme",
  "dependencies": {
    "@fhevm/solidity": "0.13.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@zama-fhe/relayer-sdk": "^0.4.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "lucide-react": "^1.39.0",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "^4.7.0",
    "forge-std": "^1.1.2",
    "terser": "5.51.2",
    "vite": "^5.4.21"
  }
}
